# ==============================================================================
# PrintPrice OS — BookPrice Configurator & Customer BFF (.env.example)
# Canonical Environment Configuration Template (budget.printprice.pro)
# ==============================================================================

# 1. Server & Runtime Environment
NODE_ENV=development
PORT=3001
PUBLIC_APP_BASE_URL=https://budget.printprice.pro
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://budget.printprice.pro,https://printprice.pro

# 2. Session, Cookie & Cryptographic Signing Secrets
SESSION_SECRET=change_me_min_32_bytes_session_secret
SIGNING_SECRET=change_me_min_32_bytes_signing_secret
OFFER_SIGNING_SECRET=change_me_offer_snapshot_signing_secret
DISPATCH_PACKAGE_TOKEN_SECRET=change_me_dispatch_package_token_secret
ADMIN_API_TOKEN=change_me_admin_api_token

# 3. Control Plane & BPE (Book Pricing Engine) Connectivity
CONTROL_PLANE_BASE_URL=http://127.0.0.1:3200
CONTROL_PLANE_AUTH_URL=http://127.0.0.1:3200
CONTROL_PLANE_API_KEY=change_me_control_plane_api_key
PPOS_CONTROL_TOKEN=change_me_control_plane_master_token
PPOS_MARKETPLACE_INTAKE_TOKEN=change_me_bff_to_control_plane_intake_token
BPE_MARKETPLACE_OFFERS_URL=https://bpe.printprice.pro/api/marketplace/offers
BPE_JWT_SECRET=change_me_min_32_bytes_bpe_jwt_secret
BPE_JWT_ISSUER=https://auth.printprice.pro
BPE_JWT_AUDIENCE=ppos:control
PPOS_BPE_SYSTEM_USER_ID=bpe-system-user

# 4. Persistence Adapter & MySQL Database
# Allowed values: 'mysql' (recommended for production) | 'json' (local fallback)
PERSISTENCE_ADAPTER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ppos_budget
DB_PASSWORD=change_me_mysql_password
DB_NAME=ppos_budget

# 5. Production PDF Asset Intake & Preflight Engine
PREFLIGHT_ENABLED=true
PREFLIGHT_BASE_URL=http://127.0.0.1:3000
PREFLIGHT_API_TOKEN=change_me_preflight_api_token
PRODUCTION_FILES_DIR=./server/storage/production-files
PRODUCTION_FILE_MAX_MB=500
PRODUCTION_FILE_RETENTION_HOURS=24
CLEANUP_ENABLED=true

# 6. Billing, Stripe Checkout & B2B Wire Transfer Escrow
PAYMENTS_ENABLED=true
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_change_me_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_change_me_stripe_webhook_secret
BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_ACCOUNT_NAME="PrintPrice OS Commercial Escrow (Merchant of Record)"
BANK_TRANSFER_IBAN="ES91 2100 0418 4502 0005 1332"
BANK_TRANSFER_SWIFT="CAIXESBBXXX"
BANK_TRANSFER_REFERENCE_PREFIX="PPOS"
PPOS_ESCROW_IBAN="ES91 2100 0418 4502 0005 1332"
PPOS_ESCROW_BIC="CAIXESBBXXX"

# 7. Printhouse Production Queue & Handoff Sync
CONTROL_PLANE_ORDER_HANDOFF_ENABLED=true
CONTROL_PLANE_ORDER_ENDPOINT=/api/admin/orders
CONTROL_PLANE_PRODUCTION_STATUS_SYNC_ENABLED=true
CONTROL_PLANE_PRODUCTION_STATUS_ENDPOINT=/api/admin/orders/:orderRef/status
AUTO_FINALIZE_AFTER_PAYMENT=true
AUTO_HANDOFF_TO_PRINTHOUSE=true

# 8. Rate Limiting, Notifications & Demo Seed Governance
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
UPLOAD_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_MAX_REQUESTS=10
NOTIFICATIONS_ENABLED=false
NOTIFICATION_PROVIDER=console
NOTIFICATION_FROM_EMAIL=noreply@printprice.pro
PPOS_SEED_DEMO_ORDERS=true
